{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenBreak",
  "version": "0.1.0",
  "identifier": "com.screenbreak.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenBreak",
        "width": 920,
        "height": 720,
        "minWidth": 780,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "pritulaziah",
    "copyright": "Copyright © 2026 pritulaziah",
    "category": "Productivity",
    "shortDescription": "Break reminders for the desktop",
    "longDescription": "ScreenBreak shows a small card over other windows. The break countdown starts at once. The card does not block the screen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
